{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ch-en-dictionary",
  "version": "0.2.4",
  "identifier": "com.kensenh.ch-en-dictionary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ch-en-dictionary",
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../cedict_dictionary/data/cedict_dictionary.db": "resources/cedict_dictionary.db",
      "../paddle_ocr_models/*": "resources/paddle_ocr_models/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
